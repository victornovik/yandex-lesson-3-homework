@startuml
!include <C4/C4_Context>

title Диаграмма контекста: передача ставок в кол-центры

Person(client, "Клиент", "Звонит узнать условия и ставки по депозитам")
Person(dep_mgr, "Менеджер бэк-офиса депозитов", "Ведёт ставки в АБС")
Person(cc_op, "Оператор кол-центра банка", "Консультирует клиентов по ставкам")
Person(partner_op, "Оператор партнёрского кол-центра", "Консультирует клиентов по ставкам")

System(abs, "АБС", "Источник ставок по депозитам")
System(ib, "Интернет-банк (сервисы депозитов)", "Хранит актуальные ставки, отдаёт их по API и выгружает в файл")
System(cc, "Система кол-центра", "Показывает ставки оператору банка")
System(sftp, "SFTP-сервер", "Хранит файлы с актуальными ставками")
System_Ext(partner_cc, "Система партнёрского кол-центра", "Внешняя система, принимает ставки только файлами")

Rel(dep_mgr, abs, "Вводит и согласует ставки")
Rel(abs, ib, "Передаёт ставки", "асинхронно, Kafka")
Rel(cc, ib, "Запрашивает актуальные ставки", "REST")
Rel(ib, sftp, "Выгружает файл со ставками", "SFTP")
Rel(partner_cc, sftp, "Забирает файл со ставками", "SFTP")

Rel(cc_op, cc, "Смотрит ставки")
Rel(partner_op, partner_cc, "Смотрит ставки")
Rel(client, cc_op, "Звонит")
Rel(client, partner_op, "Звонит")

@enduml
