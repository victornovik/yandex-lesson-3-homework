@startuml
!include <C4/C4_Context>

title Диаграмма контекста: открытие депозитов

Person(client, "Клиент")
Person(front, "Сотрудник отделения", "Идентифицирует нового клиента, оформляет документы")
Person(cc_mgr, "Менеджер кол-центра", "Звонит клиенту по заявке с сайта, предлагает особые условия")
Person(dep_mgr, "Менеджер бэк-офиса депозитов", "Ведёт ставки, обрабатывает заявки, подтверждает условия")
Person(cred_mgr, "Сотрудник кредитования", "Передаёт показатели кредитного риска для расчёта ставок")

System(site, "Сайт", "Показывает депозиты и ставки, принимает заявки от клиентов")
System(ib, "Интернет-банк", "Показывает ставки, принимает заявки на депозит с подтверждением СМС-кодом")
System(cc, "Система кол-центра", "Хранит заявки с сайта и обращения клиентов")
System(abs, "АБС", "Ведёт ставки, обрабатывает заявки, открывает депозиты, учитывает операции")
System(sms, "СМС-шлюз", "Отправка СМС через телеком-оператора")
System_Ext(telecom, "Телеком-оператор", "Доставка СМС клиентам")

Rel(client, site, "Смотрит ставки, подаёт заявку", "HTTPS")
Rel(client, ib, "Смотрит ставки, подаёт заявку, видит статус", "HTTPS")
Rel(client, front, "Приходит для идентификации и подписания документов")
Rel_Back(client, telecom, "СМС с кодом, ставкой и уведомлением об открытии")

Rel(site, cc, "Передаёт заявку", "REST")
Rel(cc_mgr, cc, "Обрабатывает заявки, предлагает условия")
Rel(cc_mgr, client, "Звонит")

Rel(ib, abs, "Заявки на депозит и статусы, ставки (асинхронно, через Kafka)")
Rel(ib, sms, "СМС-код подтверждения")
Rel(abs, ib, "Ставки и статусы заявок (асинхронно, через Kafka)")
Rel(site, ib, "Получает ставки депозитов", "REST")

Rel(dep_mgr, abs, "Ведёт ставки, обрабатывает заявки")
Rel(cred_mgr, abs, "Вносит показатели кредитного риска")
Rel(front, abs, "Открывает депозит, загружает документы")

Rel(abs, sms, "СМС-уведомления клиенту")
Rel(sms, telecom, "Отправка СМС")

@enduml